{
  "manifest_version": 3,
  "name": "YouTube ライブジャンプ",
  "version": "1.0.0",
  "description": "キーボードのキー（初期設定: F18）で YouTube ライブの「ライブ」ボタンを押し、最新の配信位置へ移動します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["common.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube ライブジャンプの設定",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
